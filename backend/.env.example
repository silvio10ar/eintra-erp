# Copiar a .env y completar los valores reales. Nunca commitear el .env real.

# ── Servidor ──────────────────────────────────────────────────────
PORT=3002
NODE_ENV=production

# Generar uno propio por instalación, por ejemplo con: openssl rand -hex 32
# No usar valores de ejemplo en producción.
JWT_SECRET=cambiar_por_un_secreto_aleatorio_unico
JWT_EXPIRES_IN=10h

# ── Base de datos ─────────────────────────────────────────────────
DB_PATH=./db/eintra_erp.db

# ── Archivos ──────────────────────────────────────────────────────
UPLOADS_PATH=../uploads
# Solo necesario si el frontend compilado no está en ../frontend/dist
# FRONTEND_DIST=

# ── SMTP (notificaciones y backup por mail) ──────────────────────
# También configurables desde Configuración > Sistema en la app (tabla `configuracion`,
# que tiene prioridad sobre estas variables si están cargadas ahí).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
BACKUP_TO=

# ── Facturación con IA (OCR de facturas, opcional) ───────────────
ANTHROPIC_API_KEY=
